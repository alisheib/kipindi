+    unreached: unreached ? unreached.slice((unreachedAt - 1) * CONSOLE_PER_PAGE, unreachedAt * CONSOLE_PER_PAGE) : null,
+    unreachedPage: unreached ? { total: unreached.length, page: unreachedAt } : null,
+  };
 }
