+/** A week's winning tickets for one player, as the settlement left them (MB-43): paid to them, or credited and held. */
+export type MillioneaWinShares = {
+  weekCode: string;
+  /** The first winning ticket's serial — the notice opens it (the S5 seal plays there). */
+  winningSerial: string;
+  /** Winning tickets whose share is the player's, and the sum paid into the main balance. */
+  paidTickets: number;
+  paidTzs: number;
+  /** Winning tickets credited and held for Compliance — a count only: a held share prints no paid figure (S5). */
+  heldTickets: number;
+  /** One ticket's share: every winning ticket's is equal (MR-24). */
+  shareTzs: number;
+  /** The winning score: 10, or the final week's highest when no ticket reached 10 (MR-30). */
+  score: number;
+  /** The withdrawal ladder as it stands at send time (MB-11): the most per withdrawal and the fee's live rate. */
+  maxPerWithdrawalTzs: number;
+  withdrawalFeeRate: number;
+  /** The account cannot sign in (self-excluded, closed, suspended): the share is paid at the holder's request (OD-13). */
+  cannotSignIn: boolean;
+};
+
+/** "Fee 1.5%": a rate as the reader reads it — at most two decimals, never a rounding to the wrong figure. */
+const pctOf = (rate: number): number => +(rate * 100).toFixed(2);
+
+/** The winning tickets in one line: at 10/10, or at the final week's highest score (MR-30). */
+function millioneaWinTickets(won: number, score: number): LocalizedText {
+  const top = score < 10;
+  return {
+    en: top ? `${won === 1 ? "1 ticket" : `${won} tickets`} at the week's highest score, ${score} of 10.` : `${won === 1 ? "1 ticket" : `${won} tickets`} at 10/10.`,
+    sw: top ? `${won === 1 ? "Tiketi 1 yenye" : `Tiketi ${won} zenye`} alama ya juu wiki hii, ${score} kati ya 10.` : `${won === 1 ? "Tiketi 1 ya 10/10" : `Tiketi ${won} za 10/10`}.`,
+    zh: top ? `${won} 张彩票获本周最高分，10 题中 ${score} 题。` : `${won} 张 10/10 彩票。`,
+  };
+}
