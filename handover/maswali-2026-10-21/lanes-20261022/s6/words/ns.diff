+/**
+ * A win whose every share is held for Compliance (MB-43) — a VERDICT, never a WIN: no share was paid, so the bell does not
+ * paint it gold, exactly as its letter wears royal. The tickets and the hold only: no figure, no reason (Compliance writes
+ * to the holder), no withdrawal ladder. Its link is the win's own key, so a holder is told once either way.
+ */
+export function notifyMillioneaWonHeld(userId: string, opts: MillioneaWinShares) {
+  const w = millioneaWeekIn(opts.weekCode);
+  const won = opts.paidTickets + opts.heldTickets;
+  const tickets = millioneaWinTickets(won, opts.score);
+  const held = {
+    en: ` The share for ${won === 1 ? "1 ticket" : `${won} tickets`} is held for now; our team will contact you.`,
+    sw: ` Zawadi ya tiketi ${won} imeshikiliwa kwa sasa; timu yetu itawasiliana nawe.`,
+    zh: `${won} 张彩票的奖金暂时保留；我们的团队会联系您。`,
+  };
+  return millioneaNotify({
+    userId,
+    kind: "VERDICT",
+    titleEn: `${w.en} · ${won === 1 ? "Your ticket won" : `${won} of your tickets won`}`,
+    titleSw: `${w.sw} · ${won === 1 ? "Tiketi yako imeshinda" : `Tiketi zako ${won} zimeshinda`}`,
+    titleZh: `${w.zh} · ${won === 1 ? "您的彩票中奖" : `您有 ${won} 张彩票中奖`}`,
+    bodyEn: `${tickets.en}${held.en}`,
+    bodySw: `${tickets.sw}${held.sw}`,
+    bodyZh: `${tickets.zh}${held.zh}`,
+    href: millioneaNoticeHref({ notice: "result", weekCode: opts.weekCode, winningSerial: opts.winningSerial }),
+  });
+}
+
+/**
+ * A week settled and none of this player's tickets won (MB-68), in the S5 hub's words ("your ticket did not win"): the
+ * loss named, with what the week cost them (LCCP: a loss is said plainly, with its amount). In a week no ticket won, the
+ * rollover — its pool carried forward with no fee (S5's `rolloverNotice`) — is told to holders only (OD-25).
+ * ⛔ `carried` is null on a break (R8-D): the line that would draw a player back is left out, never reworded.
+ */
+export function notifyMillioneaNotWon(userId: string, opts: {
+  weekCode: string;
+  tickets: number;
+  spentTzs: number;
+  /** The tickets that won this week: at 10 of 10, or at the final week's highest score. 0: nobody won, the pool carried. */
+  winningTickets: number;
+  /** The winning score (10, or the final week's highest, MR-30); null when nobody won. */
+  winningScore: number | null;
+  /** A no-winner week's carry and the week it carries into (null: not opened yet) — or null, as above. */
+  carried: { amountTzs: number; intoWeekCode: string | null } | null;
+}) {
+  const w = millioneaWeekIn(opts.weekCode);
+  const n = opts.tickets;
+  const k = opts.winningTickets;
+  const spent = formatTzs(opts.spentTzs);
+  const into = opts.carried?.intoWeekCode ? millioneaWeekWord(opts.carried.intoWeekCode) : null;
+  const carried = opts.carried ? formatTzs(opts.carried.amountTzs) : "";
+  const top = opts.winningScore !== null && opts.winningScore < 10;
+  const week = k > 0 ? {
+    en: top ? `${k === 1 ? "1 ticket" : `${k} tickets`} reached the week's highest score, ${opts.winningScore} of 10.`
+      : `${k === 1 ? "1 ticket" : `${k} tickets`} reached 10/10 this week.`,
+    sw: top ? `${k === 1 ? "Tiketi 1 ilifikia" : `Tiketi ${k} zilifikia`} alama ya juu wiki hii, ${opts.winningScore} kati ya 10.`
+      : `${k === 1 ? "Tiketi 1 ilifikia" : `Tiketi ${k} zilifikia`} 10/10 wiki hii.`,
+    zh: top ? `本周有 ${k} 张彩票获最高分（10 题中 ${opts.winningScore} 题）。` : `本周有 ${k} 张彩票达到 10/10。`,
+  } : opts.carried ? {
+    en: `No ticket reached 10/10: ${carried} carried forward ${into ? `into ${into.en}` : "to the next week"}, with no fee.`,
+    sw: `Hakuna tiketi ya 10/10: ${carried} imeletwa mbele ${into ? `kwenye ${into.sw}` : "kwenye wiki inayofuata"}, bila ada.`,
+    zh: `无 10/10 彩票：${carried} 滚存至${into ? into.zh : "下周"}，不收费用。`,
+  } : { en: "No ticket reached 10/10.", sw: "Hakuna tiketi ya 10/10.", zh: "无 10/10 彩票。" };
+  return millioneaNotify({
+    userId,
+    kind: "LOSS",
+    titleEn: `${w.en} · ${n === 1 ? "Your ticket did not win" : `Your ${n} tickets did not win`}`,
+    titleSw: `${w.sw} · ${n === 1 ? "Tiketi yako haikushinda" : `Tiketi zako ${n} hazikushinda`}`,
+    titleZh: `${w.zh} · ${n === 1 ? "您的彩票未中奖" : `您的 ${n} 张彩票未中奖`}`,
+    bodyEn: `${week.en} Spent this week · ${n === 1 ? "1 ticket" : `${n} tickets`} · ${spent}.`,
+    bodySw: `${week.sw} Ulichotumia wiki hii · tiketi ${n} · ${spent}.`,
+    bodyZh: `${week.zh}本周支出 · ${n} 张 · ${spent}。`,
+    href: millioneaNoticeHref({ notice: "result", weekCode: opts.weekCode, winningSerial: null }),
+  });
+}
