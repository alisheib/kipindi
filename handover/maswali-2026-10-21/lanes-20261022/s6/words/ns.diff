+/**
+ * The sales close, to each holder (MB-68): the week's tickets are fixed and committed (MR-13). ⛔ No payout figure — the
+ * poll's "the exact amount you receive" is a Yes/No fact a ticket does not have (MB-52).
+ */
+export async function notifyMillioneaSalesClosed(userId: string, opts: { weekCode: string; tickets: number; closedAt: string }) {
+  const w = millioneaWeekIn(opts.weekCode);
