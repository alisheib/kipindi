+    bodySw: `Mauzo yamefungwa ${at.sw}. ${n === 1 ? "Tiketi yako imefungwa" : `Tiketi zako ${n} zimefungwa`}.`,
+    bodyZh: `销售已于 ${at.zh} 截止。您的 ${n} 张彩票已锁定。`,
+    href: millioneaNoticeHref({ notice: "closed", weekCode: opts.weekCode }),
