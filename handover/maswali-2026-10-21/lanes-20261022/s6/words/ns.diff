+    bodyZh: `作废的主题多于有效备选题。${n === 1 ? "您的彩票已退款" : `您的 ${n} 张彩票已退款`} · ${money} 已退回主余额。`,
+    href: millioneaNoticeHref({ notice: "refund", weekCode: opts.weekCode }),
+  });
+}
