+/* ═══════════════════════════════════════════════════════════════════════════════════════════════════
+ * MASWALI MILLIONEA — A WEEK'S NOTICES IN THE BELL (MASWALI-BUILD S6; MASWALI-PLAN §7b S6 item 2, MB-68, OD-25)
+ *
+ * The registered set (`MILLIONEA_NOTICES`, comms-registry.ts): the receipt and the free cancel; the close, to holders; a
+ * question voided; the week's result — a win, or no win (a rollover when no ticket reached 10 of 10); and the week void's
+ * refund. `maswali-notify.ts` decides who is told and sends each once, after the money commits; these emitters only say
+ * it, in the facts and the words of the S5 hub's own notices ("Millionea Week 44: your ticket won").
+ * ⛔ NO YES/NO WORD REACHES A TICKET (MB-52, MB-68): no side, no "Bet placed", no payout before the result. The poll's
+ *    emitters are never called on a Millionea path (S3); these name a week, a ticket and its money only.
+ * ⛔ THE LINK IS THE NOTICE'S KEY (`millioneaNoticeHref`, the Up & Down digest's rule): `existsWithHref` reads it, so each
+ *    notice has one spelling per player and a second send finds the first.
+ * ⛔ A WIN STATES THE WITHDRAWAL LADDER (MB-11) — and no review, and no figure for any later week (MB-44).
+ * ⛔ A HELD WIN IS NOT PAID MONEY: it is a VERDICT, never a WIN, so no bell paints it gold (`notifyMillioneaWonHeld`).
+ * ⭐ EVERY ROW CARRIES ITS LINK AS ITS PUSH TAG (`millioneaNotify`): another product's WIN never replaces a Millionea notice
+ *    on the lock screen, and two Millionea notices never replace each other.
+ * ⭐ A CORRECTION AND A MOVED CLOSE ARE TOLD TOO (MB-24, MB-28): each its own link, so each correction is told once.
+ * ═══════════════════════════════════════════════════════════════════════════════════════════════════ */
+
+/** The player's Millionea tickets — a notice about a week, not one ticket, opens the list. */
+const MILLIONEA_TICKETS = "/millionea/tickets";
+
+/** Which notice a link keys: a ticket's own (receipt, cancel, a win), or a week's (the close, a void, the result, a refund). */
+export type MillioneaNoticeKey =
+  | { notice: "receipt"; serial: string; positionId: string }
+  | { notice: "cancel"; serial: string }
+  | { notice: "closed"; weekCode: string }
+  | { notice: "void"; weekCode: string; slot: number; sealedAt: string }
+  | { notice: "correction"; weekCode: string; slot: number; sealedAt: string }
+  | { notice: "closeMoved"; weekCode: string; move: number }
+  | { notice: "result"; weekCode: string; winningSerial: string | null }
+  | { notice: "refund"; weekCode: string };
+
+/** An instant as a key's digits (its milliseconds); 0 for an instant that does not parse. */
+const instantKey = (iso: string): number => {
+  const ms = Date.parse(iso);
+  return Number.isFinite(ms) ? ms : 0;
+};
+
+/**
+ * ⭐ EACH MILLIONEA NOTICE'S LINK, AND SO ITS KEY. A ticket's notices open its own page — the receipt at its anchor (the
+ * ticket page renders `id={positionId}`), a win where the seal plays; a week's open the tickets list. ⛔ Every shape is
+ * distinct for one player, and `maswali-notify.ts` asks `existsWithHref` with exactly this string before it sends — so
+ * changing a shape sends every notice of that kind again (the Up & Down digest's warning, `digestHref`).
+ */
+export function millioneaNoticeHref(k: MillioneaNoticeKey): string {
+  if (k.notice === "receipt") return `${millioneaTicketHref(k.serial)}#${k.positionId}`;
+  if (k.notice === "cancel") return `${millioneaTicketHref(k.serial)}#cancelled`;
+  if (k.notice === "result") return k.winningSerial ? `${millioneaTicketHref(k.winningSerial)}#won` : `${MILLIONEA_TICKETS}#${k.weekCode}-result`;
+  if (k.notice === "closed") return `${MILLIONEA_TICKETS}#${k.weekCode}-closed`;
+  // A seal's own instant is in its key: a question voided, reinstated and voided again is told each time, once.
+  if (k.notice === "void") return `${MILLIONEA_TICKETS}#${k.weekCode}-void-${k.slot}-${instantKey(k.sealedAt)}`;
+  if (k.notice === "correction") return `${MILLIONEA_TICKETS}#${k.weekCode}-corrected-${k.slot}-${instantKey(k.sealedAt)}`;
+  // ⭐ A moved close by its place among the week's moves (round 3, A7): keyed by its instant, B→A→B never told the second B.
+  if (k.notice === "closeMoved") return `${MILLIONEA_TICKETS}#${k.weekCode}-close-${k.move}`;
+  return `${MILLIONEA_TICKETS}#${k.weekCode}-refund`;
+}
+
+/** Every Millionea row goes through here: its link is its push tag (the header), so no other notice replaces it. */
+function millioneaNotify(input: NotifyInput) {
+  return notify(input, { pushTag: input.href });
+}
+
+/** "Week 44" in each language — the S5 hub's own word (`millionea.week`), from the week's stamped code. */
+function millioneaWeekWord(weekCode: string): LocalizedText {
+  const n = eatWeekNumberOf(weekCode);
+  return { en: `Week ${n}`, sw: `Wiki ${n}`, zh: `第${n}周` };
+}
+
+/** "Millionea Week 44" — the S5 away line's head ("Millionea Week {week}: …"), the product's name in Latin script. */
+function millioneaWeekIn(weekCode: string): LocalizedText {
+  const w = millioneaWeekWord(weekCode);
+  return { en: `Millionea ${w.en}`, sw: `Millionea ${w.sw}`, zh: `Millionea ${w.zh}` };
+}
+
+/**
+ * A void's ground in each language — the closed list's own sentence (`millionea.void*` through MASWALI_VOID_REASON_KEY),
+ * never a second copy. Read when asked, as `instantIn` reads the month words; a dictionary that cannot be read gives the
+ * ground's code in every language rather than lose the notice.
+ */
+async function voidGroundIn(ground: MaswaliVoidReason): Promise<LocalizedText> {
+  const key = MASWALI_VOID_REASON_KEY[ground];
+  try {
+    const { dict } = await import("@/lib/i18n-dict");
+    const say = (l: "en" | "sw" | "zh"): string => {
+      const v = (dict[l].millionea as unknown as Record<string, unknown>)[key];
+      return typeof v === "string" && v.trim() !== "" ? v : ground;
+    };
+    return { en: say("en"), sw: say("sw"), zh: say("zh") };
+  } catch {
+    return { en: ground, sw: ground, zh: ground };
+  }
+}
+
+/**
+ * The receipt of one purchase (MB-52: no side, no payout) — ONE notice for the whole purchase, which is one act and one
+ * debit: the S5 slip's own result ("Ticket cut", "{price} (main balance) · Free cancel until {time}").
+ */
+export async function notifyMillioneaTicketsCut(userId: string, opts: {
+  weekCode: string;
+  /** The purchase's serials, in sale order (one or more). */
+  serials: readonly string[];
+  /** The first ticket's position — the receipt's anchor and its key. */
+  firstPositionId: string;
+  /** What the purchase cost: the week's frozen price times the tickets. */
+  totalTzs: number;
+  /** The free cancel's end (ISO, `millioneaCancelUntil`) — null when the purchase had no free window (MR-12's runway). */
+  freeCancelUntil: string | null;
+}) {
+  const w = millioneaWeekIn(opts.weekCode);
+  const n = opts.serials.length;
+  const first = opts.serials[0] ?? "";
+  const money = formatTzs(opts.totalTzs);
+  const what = n === 1 ? { en: first, sw: first, zh: first } : { en: `${n} tickets`, sw: `Tiketi ${n}`, zh: `${n} 张彩票` };
+  const until = opts.freeCancelUntil ? await instantIn(opts.freeCancelUntil, formatEatDateTime, "—") : null;
+  return millioneaNotify({
+    userId,
+    kind: "BET_PLACED",
+    titleEn: n === 1 ? `${w.en} · Ticket cut` : `${w.en} · ${n} tickets cut`,
+    titleSw: n === 1 ? `${w.sw} · Tiketi imekatwa` : `${w.sw} · Tiketi ${n} zimekatwa`,
+    titleZh: n === 1 ? `${w.zh} · 已出票` : `${w.zh} · 已出票 ${n} 张`,
+    bodyEn: `${what.en} · ${money} (main balance)${until ? ` · Free cancel until ${until.en}` : ""}.`,
+    bodySw: `${what.sw} · ${money} (salio kuu)${until ? ` · Kughairi bila malipo hadi ${until.sw}` : ""}.`,
+    bodyZh: `${what.zh} · ${money}（主余额）${until ? ` · 免费取消至 ${until.zh}` : ""}。`,
+    href: millioneaNoticeHref({ notice: "receipt", serial: first, positionId: opts.firstPositionId }),
+  });
+}
+
+/** A free cancel (MR-12), in the S5 ticket's own words ("Ticket cancelled", "{price} returned to main balance"). */
+export function notifyMillioneaTicketCancelled(userId: string, opts: { weekCode: string; serial: string; refundedTzs: number }) {
+  const w = millioneaWeekIn(opts.weekCode);
+  const money = formatTzs(opts.refundedTzs);
+  return millioneaNotify({
+    userId,
+    kind: "DEPOSIT", // money back in the wallet, as every refund here is filed (comms-registry's note on the WIN misfiling)
+    titleEn: `${w.en} · Ticket cancelled`,
+    titleSw: `${w.sw} · Tiketi imeghairiwa`,
+    titleZh: `${w.zh} · 彩票已取消`,
+    bodyEn: `${opts.serial} · ${money} returned to main balance.`,
+    bodySw: `${opts.serial} · ${money} imerudi kwenye salio kuu.`,
+    bodyZh: `${opts.serial} · ${money} 已退回主余额。`,
+    href: millioneaNoticeHref({ notice: "cancel", serial: opts.serial }),
+  });
+}
