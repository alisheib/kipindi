+/** A week voided whole (MR-18) and every ticket refunded: the S5 notice's own words ("Your {n} tickets refunded · …"). */
+export function notifyMillioneaWeekRefunded(userId: string, opts: { weekCode: string; tickets: number; refundedTzs: number }) {
