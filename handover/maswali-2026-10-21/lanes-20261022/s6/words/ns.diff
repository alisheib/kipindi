+/**
+ * ⭐ A WIN (MB-11, OD-25) — the week, the winning tickets and the money, and how a paid share becomes cash: a confirmed
+ * email and the typed identity details, at most the per-withdrawal cap to the registered number, the RULES §2.7 fee with
+ * this win's own example (the fee's one function). ⛔ No review and no AML word (MB-11), no later week's figure (MB-44). A
+ * held share is told it is held, with no figure and no reason — Compliance writes to the holder. A locked account is told
+ * the team pays at its request (OD-13): it cannot sign in to withdraw.
+ * ⭐ The ladder is the one identity sentence a money notice carries — by MB-11's ruling (2026-10-16), the quiet rule's one
+ * exception (comms-registry.ts, beside the rule).
+ */
+export function notifyMillioneaWon(userId: string, opts: MillioneaWinShares) {
+  // ⛔ A win with no share paid is no money in the balance: it is told as a VERDICT, never a gold WIN (the header).
+  if (opts.paidTickets === 0) return notifyMillioneaWonHeld(userId, opts);
+  const w = millioneaWeekIn(opts.weekCode);
+  const won = opts.paidTickets + opts.heldTickets;
+  const paid = formatTzs(opts.paidTzs);
+  const share = formatTzs(opts.shareTzs);
+  const x = Math.min(opts.paidTzs, opts.maxPerWithdrawalTzs);
+  const arrives = formatTzs(x - computeWithdrawalFee(x, opts.withdrawalFeeRate));
+  const max = formatTzs(opts.maxPerWithdrawalTzs);
+  const pct = pctOf(opts.withdrawalFeeRate);
+  const tickets = millioneaWinTickets(won, opts.score);
+  const paidLine = opts.paidTickets === 0 ? { en: "", sw: "", zh: "" } : {
+    en: ` ${paid} paid to your main balance (${share} a ticket).`,
+    sw: ` ${paid} imelipwa kwenye salio kuu (${share} kwa tiketi).`,
+    zh: `${paid} 已支付至您的主余额（每张 ${share}）。`,
+  };
+  const ladder = opts.paidTickets === 0 ? { en: "", sw: "", zh: "" } : opts.cannotSignIn ? {
+    en: " Our team pays it to your registered number when you ask.",
+    sw: " Timu yetu itazilipa kwa namba yako iliyosajiliwa ukiomba.",
+    zh: "我们的团队将应您的请求支付至您的注册号码。",
+  } : {
+    en: ` To withdraw: a confirmed email and your typed identity details; at most ${max} per withdrawal, to your registered number; fee ${pct}% (${formatTzs(x)} arrives as ${arrives}).`,
+    sw: ` Ili kutoa: barua pepe iliyothibitishwa na taarifa zako za utambulisho ulizoandika; hadi ${max} kwa kila utoaji, kwa namba yako iliyosajiliwa; ada ${pct}% (${formatTzs(x)} inafika kama ${arrives}).`,
+    zh: `提现需要：已验证的邮箱及您填写的身份信息；每次提现最多 ${max}，转至您的注册号码；手续费 ${pct}%（${formatTzs(x)} 到账 ${arrives}）。`,
+  };
+  const heldLine = opts.heldTickets === 0 ? { en: "", sw: "", zh: "" } : {
+    en: ` The share for ${opts.heldTickets === 1 ? "1 ticket" : `${opts.heldTickets} tickets`} is held for now; our team will contact you.`,
+    sw: ` Zawadi ya tiketi ${opts.heldTickets} imeshikiliwa kwa sasa; timu yetu itawasiliana nawe.`,
+    zh: `${opts.heldTickets} 张彩票的奖金暂时保留；我们的团队会联系您。`,
+  };
+  return millioneaNotify({
+    userId,
+    kind: "WIN",
+    titleEn: opts.paidTickets > 0 ? `${w.en} · You won ${paid}` : `${w.en} · ${won === 1 ? "Your ticket won" : `${won} of your tickets won`}`,
+    titleSw: opts.paidTickets > 0 ? `${w.sw} · Umeshinda ${paid}` : `${w.sw} · ${won === 1 ? "Tiketi yako imeshinda" : `Tiketi zako ${won} zimeshinda`}`,
+    titleZh: opts.paidTickets > 0 ? `${w.zh} · 您赢得 ${paid}` : `${w.zh} · ${won === 1 ? "您的彩票中奖" : `您有 ${won} 张彩票中奖`}`,
+    bodyEn: `${tickets.en}${paidLine.en}${ladder.en}${heldLine.en}`,
+    bodySw: `${tickets.sw}${paidLine.sw}${ladder.sw}${heldLine.sw}`,
+    bodyZh: `${tickets.zh}${paidLine.zh}${ladder.zh}${heldLine.zh}`,
+    href: millioneaNoticeHref({ notice: "result", weekCode: opts.weekCode, winningSerial: opts.winningSerial }),
+  });
+}
