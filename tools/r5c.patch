+const rule = (css: string, sel: string): string => {
+  const m = new RegExp(`(?:^|\\n|\\})\\s*${sel.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\s*\\{`).exec(css);
+  if (!m) return "";
