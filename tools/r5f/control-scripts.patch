+    kind: "not-measured",
+    skips: true,
+    why: book.emptyStates > 0
+      ? "BAR NOT MEASURED — the page shows its empty state and no row; this route withholds its bar on an empty book by design (§A5). Build the fixture: npm run fixture:player"
