# scratch script that dumps NIDA/PII bypasses every masking + audit control.
db-check.*
*-check.cjs
scratch-*.js
scratch-*.cjs
*.zip
*.rar
.50pick-reports/

# Ephemeral visual-verification screenshots
docs/shots-updown/
docs/shots-final/
