# Kipindi — environment variables (copy to .env.local)

# Database (PostgreSQL)
DATABASE_URL="postgresql://kipindi:kipindi@localhost:5432/kipindi?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth (set real secrets before running)
SESSION_SECRET=""
OTP_PEPPER=""

# ── SMS — Blackball Gateway (blackballgw.co.tz) ───────────────────────────────
# `console` prints to stdout in dev and, in PRODUCTION, delivers nothing and THROWS
# (so a dropped message audits as sms.failed rather than as a false delivery).
# An unrecognised value is a FAILED choice, not a fallback to the stub — nothing is
# sent and nothing is marked sent.
SMS_PROVIDER="console"    # console | blackball
# ⛔ MAX 12 CHARACTERS. Measured against the live gateway: `source` is capped at 12
# and the cap is enforced BEFORE authentication, so one character too many fails
# EVERY send with a complaint about a field rather than about the sender ID.
SMS_SENDER_ID="50PICK"    # TCRA-licensed sender ID
BLACKBALL_CLIENT_ID=""    # portal -> Configurations -> API Configurations
BLACKBALL_CLIENT_SECRET=""
BLACKBALL_API_URL="https://blackballgw.co.tz/api/sms/send"
BLACKBALL_TIMEOUT_MS="8000"
# Register the delivery-receipt (DLR) URL with Blackball as:
#   https://<host>/api/webhooks/blackball?token=<BLACKBALL_WEBHOOK_SECRET>
# >= 16 chars, generated. A placeholder is functionally ABSENT — every callback 401s,
# delivery status is never recorded, and a message that silently failed looks exactly
# like one that arrived. Boot warns in production.
BLACKBALL_WEBHOOK_SECRET=""
# Credit floor, TZS (an SMS costs TZS 6, so 50 ≈ 8 messages and 150 ≈ 25). Below the
# floor, INVITE/OPS sends are held so the float is kept for login codes; OTP is never
# refused on cost. The alert threshold audits once, on the downward crossing. A reading
# older than the TTL is re-read from POST /api/account/balance, and unknown is never low.
SMS_BALANCE_FLOOR_TZS="50"
SMS_BALANCE_ALERT_TZS="150"
SMS_BALANCE_TTL_MS="900000"
# Largest number of phone invites one "Send" press may dispatch. The rest stay QUEUED
# and report as pending; they go out on the next press.
INVITE_SMS_MAX_PER_SEND="500"
# "1" turns PHONE-CODE LOGIN on. ⛔ Do not flip it before a real send AND a real
# delivery receipt have both been observed — with OTP on, an SMS outage is a LOGIN
# outage. Password sign-in remains the fallback either way.
OTP_ENABLED=""

# Mobile money aggregator (Selcom) — deposits AND payouts run on ONE set of creds.
# The active provider is chosen at runtime in /admin/payments (DB override) and falls
# back to PAYMENT_AGGREGATOR; a real provider is only selectable when its creds are set.
PAYMENT_AGGREGATOR=""     # "" (→ mock) | selcom | azampay
PAYMENT_API_URL=""        # Selcom base URL incl. /v1 (e.g. https://apigw.selcommobile.com/v1)
PAYMENT_API_KEY=""        # Selcom API key   (same creds for collection + disbursement)
PAYMENT_API_SECRET=""     # Selcom API secret (HMAC signing)
PAYMENT_VENDOR_ID=""      # Selcom vendor/till id (the `vendor` field)
PAYMENT_VENDOR_PIN=""     # float-account PIN — REQUIRED for payouts (Wallet Cashin); optional for deposits
PAYMENT_WEBHOOK_URL=""    # optional per-order callback URL (base64'd on the wire)
PAYMENT_TIMEOUT_MS=""     # optional gateway fetch timeout, default 45000
# Disbursement (payout) overrides — leave UNSET unless Selcom moves payouts to a SEPARATE
# float account/creds. Each falls back to the PAYMENT_* deposit var above, so unset ⇒
# payouts run on the same account as deposits (the confirmed 2026-07-27 setup).
PAYMENT_DISBURSE_URL=""
PAYMENT_DISBURSE_API_KEY=""
PAYMENT_DISBURSE_API_SECRET=""
PAYMENT_DISBURSE_VENDOR_ID=""
PAYMENT_DISBURSE_PIN=""
# FULL-WIRE CAPTURE — logs the complete Selcom request + response INCLUDING HEADERS.
# Selcom's support asks for these when a payout fails; nothing in this app kept them
# before 2026-07-30. Leave UNSET in normal running: it prints the Authorization header
# (base64 of the API key). Switch on for a diagnostic window, then switch off.
#   payouts = payout rails only (what a withdrawal test wants) · all = every call
# The float PIN is ALWAYS redacted here — there is no unmask flag, because Railway's
# log retention is not somewhere a PIN can be taken back out of. For the one case that
# needs an unmasked signing string (Selcom re-verifying a Digest), use
# `node scripts/selcom-capture.mjs --unmask-pin`, whose output goes to a file you own.
SELCOM_WIRE_LOG=""
# Per-provider webhook HMAC secrets. These EXACT names are read by
# api/webhooks/payments/route.ts — one per provider you enable. Setting a single
# PAYMENT_WEBHOOK_SECRET does NOTHING: every callback would 401 and deposits
# would never credit (audit H7). Boot warns in production if any is missing.
SELCOM_WEBHOOK_SECRET=""
AZAMPAY_WEBHOOK_SECRET=""
MIXX_WEBHOOK_SECRET=""
# Transactional email (Postmark) inbound webhook — api/webhooks/postmark/route.ts
POSTMARK_WEBHOOK_SECRET=""
# ⚠️ The SMS delivery-receipt secret is BLACKBALL_WEBHOOK_SECRET, in the SMS block above.

# KYC document object storage (audit H8) — src/lib/server/storage.ts.
# Default (unset) stores KYC images INLINE (base64 data URL) in Postgres.
# Set KYC_STORAGE=r2 + the R2 creds below to store them in Cloudflare R2 instead
# (also: npm i @aws-sdk/client-s3). Old inline rows keep working.
KYC_STORAGE=""                 # "" (inline) | r2
R2_ENDPOINT=""                 # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Error monitoring (audit H6) — src/lib/server/monitoring.ts. Set the DSN +
# `npm i @sentry/node` to ship server errors to Sentry (no-op until then).
SENTRY_DSN=""

# Redis (audit H2) — OPTIONAL and FAIL-OPEN. src/lib/server/redis.ts.
# Buys exactly three things: cross-container rate limits, SSE fan-out, and queue
# telemetry. NEVER on the bet/admission path; a Redis outage costs shared limits
# and live updates, never a bet, a login or a withdrawal.
#
# ⚠️ TWO KEYS ARM IT. REDIS_URL alone does NOTHING — REDIS_ENABLED must also be
# exactly "true". They are separate on purpose: the Railway project carries Redis
# tiles and docs/CLOUDFLARE-SETUP-GUIDE.md has an operator wire `${{Redis.REDIS_URL}}`
# for unrelated reasons, so if the URL were the on-switch a variable edit made
# while following a CDN runbook would move every login/OTP/deposit onto a Lua
# bucket with no deploy and no review. REDIS_ENABLED="false" is also the instant
# rollback — no need to delete a service reference.
REDIS_ENABLED="false"
REDIS_URL=""

# Sports data (Sprint 3) — start with API-Football
SPORTS_API_PROVIDER="api-football"
SPORTS_API_KEY=""

# NIDA verification (Sprint 1)
NIDA_API_URL=""
NIDA_API_KEY=""

# Up & Down price feed — the number real money settles against.
#
# The reader and provider are chosen at runtime in /admin/updown ("Price reading method");
# this key only enables the real provider to be USED. Selecting `twelvedata` without it
# does NOT fall back to simulated prices: every reading refuses by name, and rounds void
# and refund in full. That is deliberate — invented prices on a money path is the one
# failure this file must not make convenient.
#
# ⚠️ WHY A FEED AND NOT THE AI. Measured 2026-07-30, not assumed: across seven approved
# gold and index pages, AI page-reading returned no quoted timestamp at all, or a quote
# 9-12 hours stale (one 7.3 DAYS stale), because those pages render their price in
# client-side JavaScript that neither web_search nor web_fetch executes. With staleness
# at 90s, every 5- and 15-minute round refuses forever. The AI reader is kept only for an
# asset no feed carries.
TWELVEDATA_API_KEY=""

# Match integrity monitoring (later sprint)
INTEGRITY_PROVIDER=""     # sportradar-integrity | none
INTEGRITY_API_KEY=""

# Push notifications
FCM_SERVER_KEY=""
APN_KEY_ID=""
APN_TEAM_ID=""
